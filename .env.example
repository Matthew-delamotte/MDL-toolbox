# Leave DATABASE_URL empty for automatic local PostgreSQL on npm run dev.
# Production: use your Neon PostgreSQL URL (TLS required) or another hosted PostgreSQL.
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
ADMIN_EMAIL=matthew@mdl.local
# Required for seed; generated automatically on a fresh local startup.
ADMIN_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=
RESEND_ALERT_EMAIL=
ALERT_ALLOWED_SENDERS=
TAVILY_API_KEY=
HUNTER_API_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
DRY_RUN=true
SEED_DEMO=true
# Set only by the automatic development launcher, never on Vercel.
# LOCAL_DATABASE=false

# Provider budgets — every plan in use is a free plan. Each billable call is metered
# and refused once the cap is reached; the engine then falls back to labelled
# development output instead of failing. Leave empty to keep the conservative defaults.
TAVILY_MONTHLY_LIMIT=800
HUNTER_SEARCH_MONTHLY_LIMIT=20
HUNTER_VERIFY_MONTHLY_LIMIT=40
OPENAI_DAILY_REQUEST_LIMIT=150
